# Copy to .env and fill secrets first.
# cp .env.example .env

# --- Secrets (required) ---
SOLANA_WALLET_ADDRESS=
SOLANA_PRIVATE_KEY=
HELIUS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Auto-buy toggle ---
# 0 (default) = bot CHỈ gửi thông báo Telegram "CƠ HỘI MUA" kèm buy-links,
#               không tự ký/gửi transaction nào. Bạn tự vào lệnh thủ công.
# 1           = bot tự động mua + quản lý TP/rug/trailing-stop như trước.
AUTO_BUY_ENABLED=0

# --- Memecoin strategy baseline (requested) ---
MIN_OPPORTUNITY_SCORE=83
MIN_HOLDER_COUNT=5
MAX_TOP10_HOLDER_PCT=20

ENTRY_DIP_WINDOW_S=5
ENTRY_BBL_WINDOW_S=15
ENTRY_BBL_PERIOD=14
ENTRY_BBL_STD=1.8

TP1_PCT=25
TP2_PCT=60
TRAIL_TRIGGER_PCT=20
TRAILING_START_PCT=20
TRAILING_STOP_PCT=10

VOLUME_SPIKE_MULTIPLIER=2
MIN_LP_SOL=5
MIN_TOKEN_AGE_S=90

# --- Signal channels ---
# Comma separated channel/group IDs or @channel usernames
TELEGRAM_SIGNAL_CHANNEL=

# --- Social gating ---
# Require BOTH valid website + valid X/Twitter before candidate passes
REQUIRE_SOCIAL_WEB_X=1
SIGNAL_ALERT_MIN_SCORE=70

# --- Source D: Birdeye ---
BIRDEYE_API_KEY=
BIRDEYE_TRENDING=true
BIRDEYE_NEW_LISTING=true
BIRDEYE_CHAIN=solana
BIRDEYE_LIMIT=50

# --- Top signal digest (send highest-score tokens to group) ---
TOP_SIGNAL_ENABLED=1
TOP_SIGNAL_SIZE=10
TOP_SIGNAL_INTERVAL_S=90
TOP_SIGNAL_MAX_CANDIDATES=200

# --- Shared EVM wallet (dùng chung cho Base/BNB/ETH/Robinhood Chain) ---
# Địa chỉ ví EVM giống nhau trên mọi chain EVM (secp256k1). BASE_PRIVATE_KEY
# vẫn được dùng làm fallback nếu EVM_PRIVATE_KEY để trống (tương thích ngược).
EVM_PRIVATE_KEY=

# --- BNB Chain (PancakeSwap V2 — native swap, KHÔNG qua OKX) ---
BNB_RPC_URL=https://bsc-dataseed.binance.org
BUY_AMOUNT_BNB=0.05
# BNB_ROUTER_ADDRESS / BNB_WBNB_ADDRESS: để trống dùng default PancakeSwap V2
# chuẩn (0x10ED43C7... / WBNB 0xbb4CdB9C...). Chỉ điền nếu muốn override.
BNB_ROUTER_ADDRESS=
BNB_WBNB_ADDRESS=

# --- Ethereum mainnet (Uniswap V2 — native swap, KHÔNG qua OKX) ---
# Cần RPC riêng (Infura/Alchemy/QuickNode) — không có public RPC ổn định cho ETH mainnet.
ETH_RPC_URL=
BUY_AMOUNT_ETH=0.02
# ETH_ROUTER_ADDRESS / ETH_WETH_ADDRESS: để trống dùng default Uniswap V2
# chuẩn (Router 0x7a250d56... / WETH 0xC02aaA39...). Chỉ điền nếu muốn override.
ETH_ROUTER_ADDRESS=
ETH_WETH_ADDRESS=

# --- Robinhood Chain (Uniswap V3 — native swap, KHÔNG qua OKX) ---
# ⚠️ CHAIN RẤT MỚI (mainnet từ 7/2026, chain_id 4663). KHÔNG có default
# hardcode cho router/quoter/WETH — BẮT BUỘC bạn tự xác minh 3 địa chỉ này
# trên https://robinhoodchain.blockscout.com (hoặc docs.robinhood.com/chain)
# rồi mới điền vào đây. Bot sẽ TỪ CHỐI bật chain này nếu thiếu bất kỳ giá trị nào.
# Xem thêm: docs/USAGE_GUIDE.md
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_ROUTER_ADDRESS=
ROBINHOOD_QUOTER_ADDRESS=
ROBINHOOD_WETH_ADDRESS=
ROBINHOOD_POOL_FEE_TIER=3000
BUY_AMOUNT_ETH_ROBINHOOD=0.02

# --- Quota scan Profile/Boost mỗi chu kỳ, dùng chung cho BNB/ETH/Robinhood ---
EVM_NATIVE_MAX_PROFILE_ADDRS=40

